# Arctic Ship Navigation — Backend Environment Configuration Example
# Copy this file to .env and configure for your environment.

# ----------------------------------------------------------------------
# 1. Server & Network Configuration
# ----------------------------------------------------------------------
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# ----------------------------------------------------------------------
# 2. Database Persistence (PostgreSQL with Prisma)
# ----------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:root@localhost:5432/arctic_navigation"

# ----------------------------------------------------------------------
# 3. Marine Routing Engine
# ----------------------------------------------------------------------
# Options: 'gebco' (default custom bathymetric A* on water corridors), 'unavailable'
ROUTING_PROVIDER=gebco
ROUTING_VESSEL_DRAFT=3
ROUTING_VESSEL_SPEED=12

# ----------------------------------------------------------------------
# 4. Authentication (Optional JWT)
# ----------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# ----------------------------------------------------------------------
# 5. External Providers
# ----------------------------------------------------------------------
# Weather is retrieved live from Open-Meteo (https://open-meteo.com/) — no API key needed.
# Marine wave conditions are retrieved live from Open-Meteo Marine API.
# AIS and Iceberg satellite feeds: leave empty if unconfigured; system will return honest 503 UNAVAILABLE status.
AIS_API_KEY=
ICEBERG_API_KEY=
